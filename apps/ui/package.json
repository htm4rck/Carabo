{
  "name": "carabo-ui",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "prebuild": "npm run generate:build-info",
    "prebuild:prod": "npm run generate:build-info",
    "start": "ng serve --port 4998",
    "build": "ng build",
    "build:prod": "ng build --configuration production && node scripts/verify-production-build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:architecture": "node tools/check-architecture.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" playwright.config.ts",
    "test:architecture": "node --test tools/check-architecture.test.mjs",
    "verify": "npm run format:check && npm run lint && npm run check:architecture && npm run test:architecture && npm run typecheck && npm run typecheck:e2e && npm run test:unit && npm run build:prod",
    "e2e": "playwright test",
    "setup:browsers": "playwright install chromium",
    "security:audit": "npm audit --audit-level=high",
    "test:unit": "ng test --watch=false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@fontsource/lato": "^5.3.0",
    "ngx-scrollbar": "^19.1.4",
    "remixicon": "^4.9.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "9.39.5",
    "jsdom": "28.1.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
