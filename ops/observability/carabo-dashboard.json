{
  "title": "Carabo - Operación fiscal",
  "uid": "carabo-operations",
  "schemaVersion": 39,
  "refresh": "30s",
  "tags": ["carabo", "fiscal"],
  "panels": [
    {"id":1,"type":"stat","title":"API disponible","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"up{job=\"carabo\"}","legendFormat":"Carabo"}]},
    {"id":2,"type":"timeseries","title":"Resultados fiscales","gridPos":{"x":6,"y":0,"w":18,"h":8},"targets":[{"expr":"sum by (authority,status) (rate(carabo_fiscal_results_total[5m]))","legendFormat":"{{authority}} / {{status}}"}]},
    {"id":3,"type":"timeseries","title":"RabbitMQ procesados y DEAD","gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"expr":"sum by (result) (increase(carabo_async_messages_total[15m]))","legendFormat":"{{result}}"}]},
    {"id":4,"type":"timeseries","title":"Callbacks y webhooks","gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"sum by (result) (increase(carabo_notifications_total[15m]))","legendFormat":"{{result}}"}]},
    {"id":5,"type":"timeseries","title":"Heap JVM","gridPos":{"x":0,"y":16,"w":12,"h":8},"targets":[{"expr":"jvm_memory_used_bytes{job=\"carabo\",area=\"heap\"}","legendFormat":"{{id}}"}]},
    {"id":6,"type":"timeseries","title":"Latencia HTTP p95","gridPos":{"x":12,"y":16,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95,sum by (le,uri) (rate(http_server_requests_seconds_bucket{job=\"carabo\"}[5m])))","legendFormat":"{{uri}}"}]}
  ]
}
